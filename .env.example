# Copy to .env.local (never committed) and fill in.
# The MAIL_* and RECAPTCHA values are the same ones the old Laravel site
# (NoregnaWeb/.env) uses, so they can be copied straight across.

# --- Contact form: e-mail delivery over SMTP -------------------------------
MAIL_HOST=
MAIL_PORT=587
# "tls" = STARTTLS on 587, "ssl" = implicit TLS on 465, empty = plain
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Noregna
# Inbox that receives enquiries
CONTACT_TO=post@noregna.no

# --- Contact form: Google reCAPTCHA v2 -------------------------------------
# Site key is public (it ships to the browser); the secret stays on the server.
# Leave both empty to run without the widget (honeypot + rate limit only).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Search ---------------------------------------------------------------
# Google Search Console "HTML tag" verification token (the content= value).
GOOGLE_SITE_VERIFICATION=

# --- Contact form: alternative delivery ------------------------------------
# If SMTP is not configured, submissions are POSTed as JSON here instead.
CONTACT_WEBHOOK_URL=
